# LocalStack Configuration
# Replace the value below with your actual LocalStack Auth Token
LOCALSTACK_AUTH_TOKEN=your_localstack_auth_token_here

# GitHub Integration
# Personal Access Token with `repo` scope for posting PR comments
GITHUB_TOKEN=your_github_token_here

# Webhook secret used to verify incoming GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Gemini AI Integration
# API key for Google Gemini (used for AI-powered infrastructure analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# ShadowPlane Safety & Gateway Configuration
# Required auth token for resetting tripped circuit breakers via MCP
SHADOWPLANE_RESET_TOKEN=your_reset_token_here

# Slack Integration
# Webhook URL for dispatching verification status and change-risk reports
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
