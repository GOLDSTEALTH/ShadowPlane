# LocalStack Configuration
# Replace the value below with your actual LocalStack Auth Token
LOCALSTACK_AUTH_TOKEN=your_localstack_auth_token_here

# GitHub Integration
# Personal Access Token with `repo` scope for posting PR comments
GITHUB_TOKEN=your_github_token_here

# Webhook secret used to verify incoming GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Gemini AI Integration
# API key for Google Gemini (used for AI-powered infrastructure analysis)
GEMINI_API_KEY=your_gemini_api_key_here
